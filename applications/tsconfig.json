{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "*/**/*.ts"
  ],
  "exclude": [
    "dist",
    "package_targets",
    "**/node_modules",
    "**/.natlang",
    "pi/vendor/durable/test",
    "pi/vendor/durable/vitest*.config.ts",
    "pi/vendor/durable/src/testing",
    "pi/vendor/durable/src/storage/sqlite/cloudflare.ts",
    "pi/test"
  ]
}
