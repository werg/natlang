[
  {
    "name": "meaning-routed support task is semantic",
    "function": "isSemantic.nl",
    "inputs": {
      "task": {
        "id": "sfp-inbox-007",
        "split_group": "sfp:inbox:007",
        "constructs": [
          "readout-decision",
          "untrusted"
        ],
        "oracle": "exact",
        "prompt": "Route each support message to the team that must act on it, judging what the customer needs rather than the words they use.",
        "files": {
          "natlang.json": "{\"schema\":\"natlang.package/v2\",\"name\":\"@natlang/task-inbox-007\",\"version\":\"0.1.0\",\"description\":\"Meaning-routed support triage\",\"include\":[\"route.nl\",\"types.ts\"]}",
          "route.nl": "---\nargs:\n  message: Untrusted<string>\nreturns: \"billing\" | \"technical\" | \"account\"\nreadout: decision\n---\nDecide which team must act on message.",
          "types.ts": "export {};"
        },
        "reference": "technical",
        "negatives": [
          "billing",
          "account"
        ],
        "keywordBaseline": "billing"
      }
    },
    "expected": true
  },
  {
    "name": "keyword-routed task is not semantic",
    "function": "isSemantic.nl",
    "inputs": {
      "task": {
        "id": "sfp-inbox-008",
        "split_group": "sfp:inbox:008",
        "constructs": [
          "readout-decision",
          "untrusted"
        ],
        "oracle": "exact",
        "prompt": "Return billing when the message contains the word invoice, otherwise return technical.",
        "files": {
          "natlang.json": "{\"schema\":\"natlang.package/v2\",\"name\":\"@natlang/task-inbox-008\",\"version\":\"0.1.0\",\"description\":\"Keyword-routed support triage\",\"include\":[\"route.ts\"]}",
          "route.ts": "export const route = (m: string) => m.includes('invoice') ? 'billing' : 'technical';"
        },
        "reference": "technical",
        "negatives": [
          "billing",
          "account"
        ],
        "keywordBaseline": "billing"
      }
    },
    "expected": false
  },
  {
    "name": "policy verifier checking escalation and safety invariants is faithful",
