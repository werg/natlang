        ],
        "oracle": "verifier",
        "verifier": "policy_eval.mjs",
        "prompt": "Evaluate untrusted pull-request hunks against SQL parameterization rules and escalate any block risk above 0.25 to teacher.",
        "files": {
          "natlang.json": "{\"schema\":\"natlang.package/v2\",\"name\":\"@natlang/task-oracle-001\",\"version\":\"0.1.0\",\"description\":\"PR escalation task\",\"include\":[\"review.ts\",\"verdict.nl\",\"types.ts\"]}",
          "types.ts": "export type Verdict = 'approve' | 'request-changes' | 'block';",
          "verdict.nl": "---\nargs:\n  patch: Untrusted<string>\nreturns: Verdict\nreadout: decision\n---\nDecide merge verdict for patch.",
          "review.ts": "import verdict from './verdict.nl'; export const check = verdict;"
        },
        "reference": "block",
        "negatives": [
          "approve",
          "request-changes"
        ],
        "keywordBaseline": "approve"
      }
    },
    "expected": true
  },
