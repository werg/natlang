{
  "schema": "natlang.heartbeat-actions/1",
  "settings": {
    "stage": "advisory",
    "modes": { "diagnoseRun": "nl", "triageInbox": "nl", "planNext": "nl" },
    "repairs": 2,
    "timer_interval_minutes": 60,
    "executor_endpoint": "http://127.0.0.1:8083",
    "max_busy": 2,
    "idle_wait_seconds": 300,
    "teacher_metrics_url": "http://127.0.0.1:8082/metrics",
    "teacher_window_file": "runs/research-teacher-20261006/teacher-window.json",
    "repo": null,
    "data_roots": ["/home/werg/data", "/mnt/external"],
    "ignore_units": ["^natlang-heartbeat", "^natlang-memory-guard", "^natlang-development-cache-hygiene", "^natlang-hb-"],
    "inbox_hours": 24,
    "history_cycles": 3,
    "idle": { "headroom_gb": 30, "gpu_utilization": 15, "teacher_load": 2 },
    "cycle_argv": ["sh", "{repo}/scripts/heartbeat_cycle.sh"],
    "record_dir": "runs/heartbeat"
  },
  "actions": [
    {
      "id": "record-heartbeat",
      "what": "Append this cycle's report to the heartbeat record.",
      "argv": null, "stdin": null, "params": {}, "target": "machine", "applies_to": [], "probe": null,
      "reversible": true, "process_control": false, "owner": "program", "auto": "always", "proposable": false
    },
    {
      "id": "read-more",
      "what": "Read the last 200 journal lines of a watched unit to gather more evidence.",
      "argv": ["journalctl", "--user", "-u", "{target}", "-n", "200", "--no-pager"], "stdin": null, "params": {}, "target": "unit",
      "applies_to": ["stalled-no-error", "unknown", "code-error", "out-of-memory", "input-missing", "admission-refused", "external", "resource-contention", "gate-failed"],
      "probe": null, "reversible": true, "process_control": false, "owner": "program", "auto": "promoted", "proposable": true
    },
    {
      "id": "release-cache",
      "what": "Drop clean page cache of large files under the data roots (the cache refills).",
      "argv": ["python3", "{repo}/scripts/memory_ledger.py", "release-cache"], "stdin": null, "params": {}, "target": "machine",
      "applies_to": ["resource-contention", "out-of-memory", "admission-refused"],
      "probe": ["python3", "{repo}/scripts/memory_ledger.py", "status"],
      "reversible": true, "process_control": false, "owner": "machine-session", "auto": "promoted", "proposable": true
    },
    {
      "id": "schedule-recheck",
      "what": "Run the heartbeat once more after the given number of minutes (a transient timer that can be stopped).",
      "argv": ["systemd-run", "--user", "--on-active={minutes}m", "--unit=natlang-heartbeat-recheck", "{...cycle_argv}"], "stdin": null,
      "params": { "minutes": "minutes" }, "target": "machine",
      "applies_to": ["stalled-no-error", "unknown"],
      "probe": ["systemctl", "--user", "list-timers", "natlang-heartbeat-recheck*", "--no-pager"],
      "reversible": true, "process_control": false, "owner": "program", "auto": "promoted", "proposable": true
    },
    {
      "id": "set-status-page",
      "what": "Replace this machine's coordination status page with the plan summary.",
      "argv": ["python3", "{repo}/scripts/coord.py", "--as", "{machine}-heartbeat", "status", "--set"], "stdin": "plan-summary",
      "params": {}, "target": "machine", "applies_to": [],
      "probe": ["python3", "{repo}/scripts/coord.py", "--as", "{machine}-heartbeat", "status"],
      "reversible": true, "process_control": false, "owner": "machine-session", "auto": "promoted", "proposable": true
    },
    {
      "id": "reply-note",
      "what": "Reply to a coordination message with the given text.",
      "argv": ["python3", "{repo}/scripts/coord.py", "--as", "{machine}-heartbeat", "reply", "{target}", "-m", "{text}"], "stdin": null,
      "params": { "text": "text" }, "target": "message", "applies_to": [], "probe": null,
      "reversible": false, "process_control": false, "owner": "machine-session", "auto": "never", "proposable": true
    },
    {
      "id": "send-note",
      "what": "Send a coordination note to a machine or agent.",
      "argv": ["python3", "{repo}/scripts/coord.py", "--as", "{machine}-heartbeat", "send", "--kind", "note", "--to", "{to}", "--subject", "{subject}", "-m", "{text}"],
      "stdin": null, "params": { "to": "text", "subject": "text", "text": "text" }, "target": "machine", "applies_to": [], "probe": null,
      "reversible": false, "process_control": false, "owner": "machine-session", "auto": "never", "proposable": true
    },
    {
      "id": "ack-inbox",
      "what": "Mark the shown coordination messages read (moves the reader's cursor).",
      "argv": ["python3", "{repo}/scripts/coord.py", "inbox", "--ack"], "stdin": null, "params": {}, "target": "machine", "applies_to": [], "probe": null,
      "reversible": false, "process_control": false, "owner": "machine-session", "auto": "never", "proposable": true
    },
    {
      "id": "relaunch-run",
      "what": "Relaunch a run through the memory ledger with its declared command and the given budget.",
      "argv": null, "stdin": null, "params": { "budget_gb": "number" }, "target": "run",
      "applies_to": ["admission-refused", "out-of-memory", "stalled-no-error", "unknown"], "probe": null,
      "reversible": false, "process_control": true, "owner": "owning-session", "auto": "never", "proposable": true
    },
    {
      "id": "stop-unit",
      "what": "Stop a watched unit by name.",
      "argv": ["systemctl", "--user", "stop", "{target}"], "stdin": null, "params": {}, "target": "unit",
      "applies_to": ["stalled-no-error", "resource-contention"], "probe": null,
      "reversible": false, "process_control": true, "owner": "owning-session", "auto": "never", "proposable": true
    },
    {
      "id": "adopt-unit",
      "what": "Register a running unit with the memory ledger.",
      "argv": ["python3", "{repo}/scripts/memory_ledger.py", "adopt", "--unit", "{target}", "--budget-gb", "{budget_gb}"], "stdin": null,
      "params": { "budget_gb": "number" }, "target": "unit", "applies_to": [], "probe": null,
      "reversible": false, "process_control": true, "owner": "owning-session", "auto": "never", "proposable": true
    },
    {
      "id": "queue-next",
      "what": "Start the first step of the run's next-steps document through the ledger.",
      "argv": null, "stdin": null, "params": { "step": "text" }, "target": "run", "applies_to": [], "probe": null,
      "reversible": false, "process_control": true, "owner": "owning-session", "auto": "never", "proposable": true
    },
    {
      "id": "edit-code",
      "what": "A session edits and commits code; the report cites the files.",
      "argv": null, "stdin": null, "params": {}, "target": "path", "applies_to": [], "probe": null,
      "reversible": false, "process_control": false, "owner": "machine-session", "auto": "never", "proposable": false
    }
  ]
}
