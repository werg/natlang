[
  {
    "id": "codemod-01-crisp-logger-rename",
    "split_group": "flagship:migration-codemod:logger-crisp",
    "split": "train",
    "description": "Literal crisp rule migrates all log.infoText calls with zero LLM calls.",
    "spec": {
      "id": "logger-v3",
      "title": "Migrate legacy logger infoText",
      "description": "Replace log.infoText(...) with log.info(...).",
      "guidance": "Preserve all arguments."
    },
    "crispRules": [
      {
        "id": "r-info",
        "description": "log.infoText -> log.info",
        "find": "log.infoText(",
        "replace": "log.info(",
        "origin": "initial"
      }
    ],
    "files": [
      {
        "path": "src/a.ts",
        "content": "export const a = () => log.infoText('started');\n"
      },
      {
        "path": "src/b.ts",
        "content": "export const b = () => log.info('already migrated');\n"
      }
    ],
    "forbiddenPatterns": [
      "log.infoText("
    ],
    "expected": {
      "crispFiles": 1,
      "unchangedFiles": 1,
      "semanticFiles": 0,
      "llmCalls": 0
    }
  },
  {
    "id": "codemod-02-mixed-crisp-and-semantic-mine",
    "split_group": "flagship:migration-codemod:logger-mine",
    "split": "train",
    "description": "Crisp rule covers infoText while semantic migration + rule mining cover warnMessage.",
    "spec": {
      "id": "logger-v3-warn",
      "title": "Migrate legacy logger API",
      "description": "Rename log.infoText to log.info and log.warnMessage to log.warn.",
      "guidance": "Keep every argument unchanged."
    },
    "crispRules": [
      {
        "id": "r-info",
        "description": "log.infoText -> log.info",
        "find": "log.infoText(",
        "replace": "log.info(",
        "origin": "initial"
      }
    ],
    "files": [
      {
        "path": "src/clean.ts",
        "content": "export const ok = () => log.info('ok');\n"
      },
      {
        "path": "src/crisp.ts",
        "content": "export const c = () => log.infoText('hi');\n"
      },
      {
        "path": "src/sem1.ts",
        "content": "export const w1 = (m: string) => log.warnMessage(m);\n"
      },
      {
        "path": "src/sem2.ts",
        "content": "export const w2 = (e: string) => log.warnMessage(e);\n"
      }
    ],
    "forbiddenPatterns": [
      "log.infoText(",
      "log.warnMessage("
    ],
    "expected": {
      "crispFiles": 1,
      "unchangedFiles": 1,
      "semanticFiles": 2,
      "admittedMinedRules": 1
    }
  },
  {
    "id": "codemod-03-regex-import-extension",
    "split_group": "flagship:migration-codemod:esm-extensions",
    "split": "train",
    "description": "Regex crisp rule appends .js extension to relative ESM imports with zero model calls.",
    "spec": {
      "id": "esm-ext",
      "title": "Add .js extensions to relative imports",
      "description": "Ensure relative ESM imports end with .js.",
      "guidance": "Do not modify package imports."
    },
    "crispRules": [
      {
        "id": "r-esm",
        "description": "Append .js to relative imports",
        "find": "from '(\\.\\/[^'.]+)'",
        "replace": "from '$1.js'",
        "regex": true,
        "flags": "g",
        "origin": "initial"
      }
    ],
    "files": [
      {
        "path": "src/index.ts",
        "content": "import { util } from './util';\nimport assert from 'node:assert';\nexport { util, assert };\n"
      }
    ],
    "forbiddenPatterns": [
      "from './util'"
    ],
    "expected": {
      "crispFiles": 1,
      "unchangedFiles": 0,
      "semanticFiles": 0,
      "llmCalls": 0
    }
  },
