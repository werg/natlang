{
  "name": "natlang-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "ts-host",
    "npm-packages/*"
  ],
  "scripts": {
    "dev:setup": "scripts/setup_dev.sh",
    "natlang": "scripts/natlang",
    "runtime:update": "node scripts/update_llama_runtime.mjs",
    "build": "npm --workspace @natlang/typescript-host run build",
    "build:node": "npm --workspace @natlang/typescript-host run build:node",
    "build:applications": "npm --workspace @natlang/typescript-host run build:applications",
    "test": "npm --workspace @natlang/typescript-host test",
    "pack:node": "npm pack --workspace @natlang/node",
    "pack:browser": "npm pack --workspace @natlang/browser",
    "pack:cli": "npm pack --workspace @natlang/cli"
  },
  "devDependencies": {
    "tracing-js-self": "https://codeload.github.com/werg/tracing-js-self/tar.gz/866e7045de3a01c56de93154b2cfd2c7b47ed35b"
  }
}
