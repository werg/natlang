[Unit]
Description=natlang daily free-teacher run: list the free LLM APIs, probe, qualify and admit teachers (ops/teacher-free-models)

[Service]
Type=oneshot
WorkingDirectory=/home/werg/natlang
Nice=10
ExecStart=/usr/bin/python3 /home/werg/natlang/scripts/memory_ledger.py run --unit natlang-teacher-free-models-run --budget-gb 0.5 --priority low --class service --wait 1800 -- /usr/bin/timeout 2400 /usr/bin/python3 /home/werg/natlang/scripts/teacher_free_models.py daily
TimeoutStartSec=80min
