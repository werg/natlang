#!/usr/bin/env node
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { ensureNodeBuild } from './dev-bootstrap.mjs';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const entry = join(root, 'ts-host', 'dist', 'cli', 'main.js');
try { await ensureNodeBuild(root); }
catch (error) { process.stderr.write(`natlang: ${error instanceof Error ? error.message : String(error)}\n`); process.exit(1); }
// Packages and program state stay in the checkout; the model cache and llama.cpp runtimes are content-addressed and shared
// with an installed natlang (~/.cache/natlang and the platform's data directory), so the model is downloaded once.
process.env.NATLANG_HOME ??= join(root, '.natlang', 'packages');
process.env.NATLANG_STATE_HOME ??= join(root, '.natlang', 'state');
const { main } = await import(pathToFileURL(entry).href);
process.exitCode = await main(process.argv.slice(2));
