#!/usr/bin/env node
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { ensureNodeBuild } from './dev-bootstrap.mjs';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const entry = join(root, 'ts-host', 'dist', 'cli', 'main.js');
try {
  ensureNodeBuild(root);
} catch (error) {
  process.stderr.write(`natlang-app: ${error instanceof Error ? error.message : String(error)}\n`); process.exit(1);
}
const [applicationPath, ...args] = process.argv.slice(2);
if (!applicationPath || applicationPath === '--help' || applicationPath === '-h') {
  process.stdout.write('Usage: scripts/natlang-app MANIFEST_OR_DIRECTORY [NATLANG OPTIONS] [-- APP OPTIONS]\n');
  process.exit(0);
}
process.env.NATLANG_HOME ??= join(root, '.natlang', 'packages');
process.env.NATLANG_STATE_HOME ??= join(root, '.natlang', 'state');
process.env.NATLANG_CACHE_HOME ??= join(root, '.natlang', 'cache');
const { main } = await import(pathToFileURL(entry).href);
main(['app', 'run', applicationPath, ...args]).then(code => { process.exitCode = code; }, error => {
  process.stderr.write(`natlang-app: ${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
});
