{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natlang.dev/spec/neuralese-file.schema.json",
  "title": "natlang .nz file header",
  "description": "JSON stored under the `natlang` key of a .nz file's safetensors metadata (spec/NEURALESE_FILES.md).",
  "type": "object",
  "required": ["format", "dialect", "exports"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "natlang.neuralese-file/1" },
    "dialect": { "$ref": "#/$defs/dialect" },
    "types": { "type": "string", "description": "Natlang type declarations available to export types." },
    "exports": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "description": "Natlang type syntax." },
          "value": { "$ref": "#/$defs/value" },
          "description": { "type": "string" }
        }
      }
    },
    "native_states": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nativeStateId" },
      "additionalProperties": { "$ref": "#/$defs/artifactEntry" },
      "description": "Exact native-state safetensors bodies, each stored as one U8 tensor and verified against its nzs1 content address."
    },
    "native_tensors": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nativeTensorId" },
      "additionalProperties": { "$ref": "#/$defs/artifactEntry" },
      "description": "Exact named tensor artifact bodies (adapter coefficients and bases, gradients, optimizer state, derivative programs), each stored as one U8 tensor and verified against its nnt1 content address."
    },
    "skill": {
      "type": "object",
      "required": ["name", "description", "body"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "body": { "type": "string", "description": "Export holding the skill body." },
        "natlang": {
          "type": "object",
          "properties": {
            "scope": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Scope binding name to export name." },
            "exports": { "type": "string" },
            "requires": { "type": "array", "items": { "type": "string" } },
            "tests": { "type": "array" },
            "provenance": { "type": "object" }
          }
        }
      }
    },
    "provenance": { "type": "object" }
  },
  "$defs": {
    "dialect": { "type": "string", "pattern": "^(?:native-state/[A-Za-z0-9_.-]+|native-tensor/[a-z-]+|semantic-state/[0-9a-f]{64})$" },
    "nativeStateId": { "type": "string", "pattern": "^nzs1_[a-z2-7]{52}$" },
    "nativeTensorId": { "type": "string", "pattern": "^nnt1_[a-z2-7]{52}$" },
    "artifactEntry": {
      "type": "object", "required": ["bytes"], "additionalProperties": false,
      "properties": { "bytes": { "type": "integer", "minimum": 1 } }
    },
    "softRef": {
      "type": "object",
      "required": ["$neuralese"],
      "additionalProperties": false,
      "properties": {
        "$neuralese": {
          "type": "object",
          "required": ["type", "id"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "id": { "$ref": "#/$defs/nativeStateId" },
            "stop_gradient": { "const": true, "description": "This use is a constant in gradients." },
            "source_occurrence": { "type": "string", "minLength": 1, "description": "The producing graph occurrence." }
          }
        }
      }
    },
    "softFunction": {
      "type": "object",
      "required": ["$neuralese-fn"],
      "additionalProperties": false,
      "properties": {
        "$neuralese-fn": {
          "type": "object",
          "required": ["type", "body", "captures"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "body": { "$ref": "#/$defs/nativeStateId" },
            "body_stop_gradient": { "const": true },
            "body_source_occurrence": { "type": "string", "minLength": 1 },
            "captures": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
          }
        }
      }
    },
    "nativeAdapter": {
      "type": "object",
      "required": ["$nativeAdapter"],
      "additionalProperties": false,
      "properties": {
        "$nativeAdapter": {
          "type": "object", "required": ["id"], "additionalProperties": false,
          "properties": { "id": { "$ref": "#/$defs/nativeTensorId" } }
        }
      }
    },
    "nativeTensor": {
      "type": "object",
      "required": ["$nativeTensor"],
      "additionalProperties": false,
      "properties": {
        "$nativeTensor": {
          "type": "object", "required": ["id", "kind"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/nativeTensorId" },
            "kind": { "enum": ["parameter-set", "parameter-gradient", "parameter-update", "state-gradient", "optimizer-state",
              "adapter-basis", "adapter-gradient", "derivative-program"] }
          }
        }
      }
    },
    "exportRef": {
      "type": "object",
      "required": ["$ref"],
      "additionalProperties": false,
      "properties": { "$ref": { "type": "string" } }
    },
    "value": {
      "anyOf": [
        { "$ref": "#/$defs/softRef" },
        { "$ref": "#/$defs/softFunction" },
        { "$ref": "#/$defs/nativeAdapter" },
        { "$ref": "#/$defs/nativeTensor" },
        { "$ref": "#/$defs/exportRef" },
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      ]
    }
  }
}
