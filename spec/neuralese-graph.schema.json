{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natlang.dev/spec/neuralese-graph.schema.json",
  "title": "natlang execution-graph node",
  "description": "One node event of a natlang.exec-graph/1 record (spec/NEURALESE_GRAPH.md). Records are sequences of trace events; node events carry `node` and `inputs` in addition to the trace event fields.",
  "type": "object",
  "required": ["version", "seq", "kind", "node"],
  "properties": {
    "version": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "node": { "type": "string" },
    "kind": {
      "enum": [
        "invocation", "context_bind", "model_turn", "block_write", "block_read", "readout",
        "combinator", "rewrite", "effect", "iteration_step", "literal"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node"],
        "additionalProperties": false,
        "properties": {
          "node": { "type": "string" },
          "port": { "type": "string" },
          "block": { "$ref": "#/$defs/blockId" },
          "source": { "type": "string" },
          "stop": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "block_write" } } },
      "then": {
        "required": ["turn", "length", "truncated", "block", "stops"],
        "properties": {
          "turn": { "type": "string" },
          "length": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "truncated": { "type": "boolean" },
          "block": { "$ref": "#/$defs/blockId" },
          "format": { "const": "native-state" },
          "position": { "type": "integer", "minimum": 0 },
          "native_identity": { "type": "object" },
          "stops": { "type": "array", "maxItems": 0, "description": "Always empty: a producer span ends at the model's end marker." }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "model_turn" } } },
      "then": {
        "required": ["turn"],
        "properties": {
          "turn": { "type": "integer", "minimum": 1 },
          "temperature": { "type": ["number", "null"], "minimum": 0 },
          "seed": { "type": ["integer", "null"] },
          "calls": { "type": "array" },
          "readout": { "enum": ["decision"] }
        },
        "allOf": [{
          "if": { "required": ["readout"], "properties": { "readout": { "const": "decision" } } },
          "then": { "properties": { "temperature": { "const": null }, "seed": { "const": null }, "calls": { "maxItems": 0 } } }
        }]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "literal" } } },
      "then": {
        "required": ["block", "type", "expression"],
        "properties": { "block": { "$ref": "#/$defs/blockId" }, "type": { "type": "string" }, "expression": { "type": "string" } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "iteration_step" } } },
      "then": {
        "required": ["iteration_id", "step", "phase"],
        "properties": {
          "iteration_id": { "type": "string" },
          "step": { "type": "integer", "minimum": 0 },
          "phase": { "enum": ["initial", "step", "review", "done"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "context_bind" } } },
      "then": {
        "required": ["from", "to", "check"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "check": { "enum": ["passed", "failed"] } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "block_read" } } },
      "then": {
        "required": ["turn", "block", "positions"],
        "properties": {
          "turn": { "type": "string" },
          "stop_gradient": { "const": true },
          "block": { "$ref": "#/$defs/blockId" },
          "positions": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "position_source": { "enum": ["captured_prompt_segment"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "invocation" } } },
      "then": {
        "required": ["definition", "context"],
        "properties": {
          "definition": { "type": "object", "required": ["id", "revision"] },
          "context": { "type": "string" },
          "captures": {
            "type": "object",
            "additionalProperties": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["implicit-live", "snapshot", "live"] } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "rewrite" } } },
      "then": {
        "required": ["rule", "site", "replaced"],
        "properties": {
          "rule": { "enum": ["map-fusion", "read-map", "map-identity", "combine-reassociate", "combine-identity", "split-zip"] },
          "site": { "type": "string" },
          "replaced": { "type": "array", "items": { "type": "string" } },
          "enabled_by": { "type": "string" }
        }
      }
    }
  ],
  "$defs": {
    "blockId": { "type": "string", "pattern": "^nzs1_[a-z2-7]{52}$" }
  }
}
