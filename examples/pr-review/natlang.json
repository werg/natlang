{
  "schema": "natlang.package/v2",
  "name": "pr-review",
  "version": "0.1.0",
  "description": "Review pull-request diffs against team rules with grounded quotes, asymmetric block escalation, and ranked findings.",
  "include": [
    "check_hunk",
    "check_hunk.nl",
    "diff.json",
    "examples.json",
    "main.ts",
    "merge_verdict.nl",
    "package.json",
    "README.md",
    "review.ts",
    "rules.json",
    "tsconfig.json",
    "types.ts"
  ],
  "targets": {
    "main": {
      "entry": "main.ts",
      "description": "Review diff.json against rules.json."
    }
  }
}
