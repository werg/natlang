{
  "schema": "natlang.package/v2",
  "name": "hello",
  "version": "0.1.0",
  "description": "My first natlang program.",
  "include": [
    "answer.nl",
    "main.ts",
    "sample.json",
    "examples.json",
    "package.json",
    "tsconfig.json",
    "README.md"
  ],
  "targets": {
    "main": {
      "entry": "main.ts",
      "description": "Run with sample input, or supply your own text.",
      "arguments": [
        {
          "name": "input",
          "type": "string",
          "description": "Text to process; leave blank to use sample.json."
        }
      ]
    }
  },
  "warmup": [
    {
      "name": "sample input",
      "function": "answer.nl",
      "inputs": {
        "input": "I was charged twice for my subscription."
      }
    }
  ]
}
