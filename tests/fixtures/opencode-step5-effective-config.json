{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/step-5-preview-free",
  "small_model": "opencode/step-5-preview-free",
  "permission": {
    "*": "ask",
    "natlang_action_bridge_submit_action": "allow"
  },
  "mcp": {
    "natlang_action_bridge": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "/test/action-server.mjs"
      ],
      "enabled": true,
      "environment": {
        "NATLANG_OPENCODE_ACTION_LOG": "/test/action-calls.jsonl",
        "NATLANG_OPENCODE_MCP_HANDSHAKE_LOG": "/test/mcp-handshake.jsonl"
      }
    }
  },
  "share": "disabled",
  "autoupdate": false
}
