      "evidence": [
        {
          "path": "articles/12.md",
          "paragraph": "Kublai (; ; ) was the fifth Khagan (Great Khan) of the Mongol Empire (\"Ikh Mongol Uls\"), reigning from 1260 to 1294 (although due to the division of the empire this was a nominal position). He also founded the Yuan dynasty in China as a conquest dynasty in 1271, and ruled as the first Yuan emperor until his death in 1294.\n",
          "paragraph_sha256": "ab9dfdd2ecdaaf01995f91e3ce552a4c719ec653be38b4610a4873dfcd10b68d",
          "supplied_file_sha256": "6b4f300aeb54fbaafc06e7382723a67123cb3baa002a4b13b1d3ceff796a69d5",
          "claim_supported": true
        }
