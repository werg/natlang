      "evidence": [
        {
          "path": "articles/9.md",
          "paragraph": "A large number of international institutions have their seats in Switzerland, in part because of its policy of neutrality. Geneva is the birthplace of the Red Cross and Red Crescent Movement and the Geneva Conventions and, since 2006, hosts the United Nations Human Rights Council. Even though Switzerland is one of the most recent countries to have joined the United Nations, the Palace of Nations in Geneva is the second biggest centre for the United Nations after New York, and Switzerland was a founding member and home to the League of Nations.\n",
          "paragraph_sha256": "aa0325047d1accbb8c38038eff7763838a956677228dc134c1c96fe4e031a7bf",
          "supplied_file_sha256": "6a712ec602ece7775085ae61fee2d425c236a9c8b4b64db7c48e7821cf6476ca",
          "claim_supported": true
