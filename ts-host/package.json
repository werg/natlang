{
  "name": "@natlang/typescript-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:conformance",
    "test:conformance": "node scripts/native-conformance.mjs && node scripts/native-harness.mjs"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "prelude.js",
    "README.md"
  ]
}
