        ]
      }
    ]
  },
  "persistence": {
    "state": "per-action execution, postcondition, and authority history",
    "history": "unknown and partial outcomes block automatic retry; every receipt is idempotent by external receipt identity",
    "closure": "command completion does not establish user-outcome restoration or incident closure"
  },
  "effects": {
    "diagnostics": "allowlisted and budget checked; intrusive checks require commander approval",
    "recovery": "proposal only; no shell command or production action is dispatched"
  },
