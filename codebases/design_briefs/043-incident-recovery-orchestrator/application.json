      {
        "id": 2,
        "paths": [
          "recoverIncident/verifyUserOutcomeRecovery.nl",
          "recoverIncident/verifyUserOutcomeRecovery/identifyUnverifiedUserCohorts.nl"
        ]
      },
      {
        "id": 3,
        "paths": [
          "recoverIncident/reconcileAmbiguousActionCompletion.nl"
        ]
      },
      {
        "id": 4,
        "paths": [
