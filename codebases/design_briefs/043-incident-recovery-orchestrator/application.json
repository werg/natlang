{
  "schema": "natlang.application/1",
  "id": "043",
  "title": "Incident recovery orchestrator",
  "entrypoint": "recoverIncident.nl",
  "interfaces": [
    {
      "name": "recoverIncident",
      "path": "recoverIncident.nl",
      "purpose": "Scope observed user impact, maintain provisional causes, bound diagnostics, sequence authorized runbooks, and verify user outcomes."
    },
    {
      "name": "reconcileIncidentActionReceipt",
      "path": "reconcileIncidentActionReceipt.nl",
      "purpose": "Reconcile actual runbook command execution, renewed commander authority, preconditions, and postcondition evidence before retry or closure.",
      "stateParameter": "book",
      "stateResultPath": [
        "book"
      ],
      "stateKey": "incident-recovery-action-ledger"
    }
  ],
  "coverage": {
