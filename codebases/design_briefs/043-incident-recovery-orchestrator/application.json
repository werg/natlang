          "recoverIncident/compareCausalExplanations/separateEvidenceByHypothesis.nl"
        ]
      },
      {
        "stage": "selectDiagnostics",
        "paths": [
          "recoverIncident/constrainDiagnosticQueries.nl",
          "recoverIncident/constrainDiagnosticQueries/enforceDeclaredQueryBudget.nl"
        ]
