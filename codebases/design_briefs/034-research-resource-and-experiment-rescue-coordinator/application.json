{
  "schema": "natlang.application/1",
  "id": "034",
  "title": "Research resource and experiment rescue coordinator",
  "entrypoint": "coordinateResearchWindow.nl",
  "interfaces": [
    {
      "name": "coordinateResearchWindow",
      "path": "coordinateResearchWindow.nl",
      "purpose": "Build a protocol-bound resource assignment, rescue branch, readiness decision, and consumption ledger."
    },
    {
      "name": "parseProtocolConstraints",
      "path": "coordinateResearchWindow/parseProtocolConstraints.nl",
      "purpose": "Separate approved experimental conditions from researcher preferences."
    },
    {
      "name": "reconcileResourceCalendar",
      "path": "coordinateResearchWindow/reconcileResourceCalendar.nl",
      "purpose": "Check capability, calibration, booking, maintenance, and operator qualification."
    },
    {
      "name": "solveWindowAssignments",
      "path": "coordinateResearchWindow/solveWindowAssignments.nl",
      "purpose": "Search finite instrument and operator windows without relaxing hard constraints."
    },
    {
      "name": "proposeResearchRescue",
      "path": "coordinateResearchWindow/proposeResearchRescue.nl",
      "purpose": "Compare resequencing, qualified substitutes, and postponement with explicit deviation review."
    },
    {
      "name": "reconcileConsumedMaterials",
      "path": "coordinateResearchWindow/reconcileConsumedMaterials.nl",
      "purpose": "Retain preparation consumption and identify explicitly dependent experiments."
    },
    {
      "name": "recheckDayOfReadiness",
      "path": "coordinateResearchWindow/recheckDayOfReadiness.nl",
      "purpose": "Revalidate current facts immediately before execution while preserving bookings."
    }
  ],
  "mechanisms": [
    {
      "name": "intervalsOverlap",
      "path": "coordinateResearchWindow/solveWindowAssignments/walkScheduleFrontier/expandFrontierLayer/expandOneFrontier/expandOneFrontier/testAssignmentFeasibility/testAssignmentConflicts/intervalsOverlap.ts",
      "purpose": "Exact half-open interval arithmetic only; NatLang owns candidate search, branching, and ranking."
    }
  ],
