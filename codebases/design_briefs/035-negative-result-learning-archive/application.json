      "path": "negativeResultDossier/adjudicateInferenceValidity.nl",
      "purpose": "Keep valid negative, invalid, incomplete, and uncertain outcomes epistemically distinct."
    },
    {
      "name": "compareRivalMechanisms",
      "path": "negativeResultDossier/compareRivalMechanisms.nl",
      "purpose": "Keep demonstrated causes and plausible alternatives linked to supporting and contrary observations."
    },
    {
      "name": "designDiscriminatingFollowups",
      "path": "negativeResultDossier/designDiscriminatingFollowups.nl",
      "purpose": "Declare rival-specific outcome predictions and enforce safe, authorized bounds."
    },
    {
      "name": "reviseScopedLessons",
      "path": "negativeResultDossier/reviseScopedLessons.nl",
      "purpose": "Version lessons by tested conditions and preserve contradictory and superseding evidence."
    },
    {
      "name": "reconcileFollowupExecution",
      "path": "reconcileFollowupExecution.nl",
      "purpose": "Classify and preserve actual preregistered follow-up outcomes, including invalid, incomplete, unknown, and contradictory runs.",
