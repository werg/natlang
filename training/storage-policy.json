{
  "schema": "natlang.storage-policy/1",
  "policy": "plans/STORAGE_POLICY.md. KEEP is never deleted. PRUNE-AUTO is deleted by scripts/storage_retention.py --apply (deletion manifest kept). PRUNE-ASK is listed for the owner and deleted only when named in an approval file. When in doubt a file is PRUNE-ASK.",
  "roots": {
    "scan": [
      "/home/werg/natlang/runs",
      "/home/werg/data",
      "/mnt/external/natlang-development-data"
    ],
    "report_only": [
      "/mnt/external",
      "/home/werg/.cache"
    ]
  },
  "archive": {
    "root": "/mnt/external/natlang-development-data/archive",
    "manifest": "/mnt/external/natlang-development-data/archive/manifest.jsonl"
  },
  "min_report_bytes": 1073741824,
  "finished_after_days": 3,
  "aborted_after_days": 7,
  "leftover_after_days": 2,
  "keep": {
    "registries": [
      "training/neuralese_corpora.json",
      "training/neuralese_artifacts.json"
    ],
    "reference_texts": [
      "runs/*.sh",
      "runs/*/*.sh",
      "training/neuralese/recipes/*.json",
      "training/*.json",
      "training/neuralese/*.json",
      "plans/**/*.md",
      "runs/*/*certificate*.json",
      "runs/*/*/*certificate*.json",
      "runs/*/*receipt*.json",
      "runs/*/*/*receipt*.json",
      "runs/*/*qualification*.json",
      "runs/*/*/*qualification*.json"
    ],
    "name_patterns": [
      "*.log",
      "*.md",
      "*receipt*",
      "*certificate*",
      "*qualification*",
      "*labels*",
      "*clef*",
      "*human*"
    ],
    "path_patterns": [
      "/home/werg/data/models/*",
      "/home/werg/data/bird-sqlite/*",
      "/home/werg/natlang-data-nvme/*",
      "/mnt/external/bgkit-data/models/hf/Qwen3.6-35B-A3B-NVFP4/*",
      "/mnt/external/natlang-vllm-qwen36/*",
      "/home/werg/.local/share/natlang/calls/*",
      "/home/werg/natlang/runs/natlang-target-union-20261011-r3/*"
    ],
    "docker": {
      "why": "Active infrastructure, never retired: the vLLM teacher (scripts/teacher/run-qwen36.sh, scripts/ensure_teacher.sh, unit natlang-qwen36-teacher) serves :8082 for teacher data, live measurements, the specializer and the weekly teacher window. An exited container is not a retired one: it is started on demand.",
      "containers": [
        "natlang-qwen36-nvfp4-server"
      ],
      "images": [
        "vllm-node",
        "sha256:666307b207f9f583f6048111e90c5d177355a2f94d9101494c8c85c5b277471d"
      ]
    },
    "latency_critical_nvme": {
      "why": "Owner rule (2026-10-13 NVMe relief): stays on the NVMe; never archived to /mnt/external. Active training inputs, the running lineage's latest checkpoint and reserve, scorer DBs, the HF model training loads, the live call store.",
      "paths": [
        "/home/werg/natlang/runs/natlang-target-union-20261011-r3",
        "/home/werg/natlang/runs/neuralese-direct-mellum-20261011/run-v4/direct_sft/checkpoint.pt",
        "/home/werg/natlang/runs/neuralese-direct-mellum-20261011/run-v4/direct_sft/.checkpoint-space.reserve",
        "/home/werg/data/bird-sqlite",
        "/home/werg/natlang-data-nvme",
        "/home/werg/data/models/mellum21-12b-a2.5b-thinking",
        "/home/werg/.local/share/natlang/calls"
      ]
    }
  },
  "checkpoint": {
    "suffixes": [
      ".pt",
      ".pth",
      ".safetensors",
      ".bin",
      ".ckpt"
    ],
    "name_patterns": [
      "*checkpoint*",
      "*ckpt*",
      "*step*",
      "*state*",
      "*optimizer*",
      "*latest*",
      "*best*",
      "*final*"
    ],
    "step_regex": "(?:step|ckpt|checkpoint)[-_]?(\\d+)|[-_](\\d{3,})(?:\\.[a-z]+)+$",
    "best_patterns": [
      "*best*"
    ],
    "final_patterns": [
      "*final*",
      "*export*"
    ]
  },
  "aborted_run_markers": [
    "aborted",
    "guard-stopped",
    "floor-stopped",
    "failed",
    "stopped-step"
  ],
  "leftover_patterns": [
    "*.pending",
    "*.tmp",
    "*.partial"
  ],
  "prune_auto": [
    "intermediate-checkpoint",
    "aborted-run-checkpoint",
    "leftover",
    "docker-dangling"
  ],
  "checkpoint_cadence": {
    "points": "declared steps: eval_every (about 10-20 per stage, last at the stage end), checkpoint_every a multiple of eval_every sized to about 3 h at the measured step time",
    "eval_every": "per stage (recipe)",
    "checkpoint_every": "per stage (recipe)",
    "on_sigterm": true,
    "rolling_slots": 1,
    "best_weights_only": false,
    "drop_optimizer_at_end": false,
    "disk_aware": true,
    "best": "hard link to the best full-state write"
  }
}
