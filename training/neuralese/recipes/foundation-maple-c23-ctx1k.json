{
 "schema": "natlang.neuralese-training-recipe/1",
 "id": "token-preserving-foundation-maple-c23-ctx1k",
 "description": "foundation-maple at cutoff 23 with 1,024 context windows (c23 with 512 plateaued at held agreement 0.854 / KL 0.126 from ~4k steps: KL passes, agreement does not; more data next).",
 "stages": [
  {
   "id": "token_identity",
   "kind": "token_identity",
   "requires": [],
   "parameters": {
    "limit": 32,
    "max_tokens": 512
   }
  },
  {
   "id": "embedding_distillation",
   "kind": "causal_embedding_distillation",
   "requires": [
    "token_identity"
   ],
   "parameters": {
    "cutoff": 23,
    "steps": 8192,
    "batch": 512,
    "lr": 0.0003,
    "tokens": 1024,
    "contexts": 1024,
    "context_tokens": 1024,
    "eval_every": 128,
    "checkpoint_every": 128,
    "agreement_gate": 0.9,
    "kl_gate": 0.25,
    "source_fraction": 0.25,
    "argmax_weight": 0.1,
    "seed": 0
   }
  }
 ]
}
