{
  "schema": "natlang.neuralese-training-recipe/1",
  "id": "token-preserving-foundation-v1",
  "description": "Mandatory foundation for the new raw-token channel. Further runtime, compression and recurrence stages require their own gates; this recipe does not qualify them.",
  "stages": [
    {
      "id": "token_identity",
      "kind": "token_identity",
      "requires": [],
      "parameters": {"limit": 32, "max_tokens": 512}
    },
    {
      "id": "embedding_distillation",
      "kind": "causal_embedding_distillation",
      "requires": ["token_identity"],
      "parameters": {
        "cutoff": 14,
        "steps": 8192,
        "batch": 512,
        "lr": 0.0003,
        "tokens": 1024,
        "contexts": 128,
        "context_tokens": 1024,
        "eval_every": 128,
        "checkpoint_every": 128,
        "agreement_gate": 0.9,
        "kl_gate": 0.25,
        "source_fraction": 0.25,
        "argmax_weight": 0.1,
        "seed": 0
      }
    }
  ]
}
