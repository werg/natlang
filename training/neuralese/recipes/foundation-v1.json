{
  "schema": "natlang.neuralese-training-recipe/1",
  "id": "token-preserving-foundation-v1",
  "description": "Required exact token foundation and raw transport/replay qualification. Learned stopping and semantic compression require separate task gates.",
  "stages": [
    {
      "id": "token_identity",
      "kind": "token_identity",
      "requires": [],
      "parameters": {
        "limit": 32,
        "max_tokens": 512
      }
    },
    {
      "id": "embedding_distillation",
      "kind": "causal_embedding_distillation",
      "requires": [
        "token_identity"
      ],
      "parameters": {
        "cutoff": "full",
        "steps": 8192,
        "batch": 512,
        "lr": 0.0003,
        "tokens": 1024,
        "contexts": 128,
        "context_tokens": 1024,
        "eval_every": 128,
        "checkpoint_every": 128,
        "agreement_gate": 0.9,
        "kl_gate": 0.25,
        "source_fraction": 0.25,
        "argmax_weight": 0.1,
        "stop_on_gate": true,
        "seed": 0
      }
    },
    {
      "id": "runtime_qualification",
      "kind": "raw_runtime_qualification",
      "requires": [
        "embedding_distillation"
      ],
      "parameters": {
        "limit": 8,
        "max_length": 128
      }
    }
  ]
}
