{
 "schema": "natlang.neuralese-training-recipe/1",
 "id": "token-preserving-foundation-maple-c23-ctx512",
 "description": "foundation-maple at cutoff 23 with 512 context windows (held best agreement/KL: c12 0.54/1.24, c18 0.646/0.748, c21 0.789/0.283 still improving at step 8064; depth helps most).",
 "stages": [
  {
   "id": "token_identity",
   "kind": "token_identity",
   "requires": [],
   "parameters": {
    "limit": 32,
    "max_tokens": 512
   }
  },
  {
   "id": "embedding_distillation",
   "kind": "causal_embedding_distillation",
   "requires": [
    "token_identity"
   ],
   "parameters": {
    "cutoff": 23,
    "steps": 8192,
    "batch": 512,
    "lr": 0.0003,
    "tokens": 1024,
    "contexts": 512,
    "context_tokens": 1024,
    "eval_every": 128,
    "checkpoint_every": 128,
    "agreement_gate": 0.9,
    "kl_gate": 0.25,
    "source_fraction": 0.25,
    "argmax_weight": 0.1,
    "seed": 0
   }
  }
 ]
}
