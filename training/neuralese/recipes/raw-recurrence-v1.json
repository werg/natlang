{
  "schema": "natlang.neuralese-training-recipe/1",
  "id": "raw-recurrence-v1",
  "description": "Mandatory token foundation, projection-first/full-stack ordinary text warm-up, adapted-weight runtime qualification, then Natlang trajectories. No alternate neuralese training path.",
  "stages": [
    {
      "id": "token_identity",
      "kind": "token_identity",
      "requires": [],
      "parameters": {
        "limit": 32,
        "max_tokens": 512
      }
    },
    {
      "id": "embedding_distillation",
      "kind": "causal_embedding_distillation",
      "requires": [
        "token_identity"
      ],
      "parameters": {
        "cutoff": "full",
        "steps": 8192,
        "batch": 512,
        "lr": 0.0003,
        "tokens": 1024,
        "contexts": 128,
        "context_tokens": 1024,
        "eval_every": 128,
        "checkpoint_every": 128,
        "agreement_gate": 0.9,
        "kl_gate": 0.25,
        "source_fraction": 0.25,
        "argmax_weight": 0.1,
        "stop_on_gate": true,
        "seed": 0
      }
    },
    {
      "id": "runtime_qualification",
      "kind": "raw_runtime_qualification",
      "requires": [
        "embedding_distillation"
      ],
      "parameters": {
        "limit": 8,
        "max_length": 512
      }
    },
    {
      "id": "core_text_warmup",
      "kind": "core_text_warmup",
      "requires": [
        "runtime_qualification"
      ],
      "parameters": {
        "steps": 4096,
        "tokens": 1024,
        "prefix_tokens": 32,
        "cutoff": 4,
        "group_size": 16,
        "backbone_training": "auto",
        "optimizer": "muon",
        "eval_every": 128,
        "checkpoint_every": 128,
        "lr": 3e-05,
        "sketch_lr": 0.0003,
        "embedding_weight": 1.0,
        "sketch_weight": 1.0,
        "text_weight": 0.25,
        "max_ce_delta": 0.1,
        "max_relative_mse": 0.25,
        "min_agreement": 0.9,
        "consecutive_gates": 2,
        "batch": 2,
        "projection_patience": 3,
        "projection_min_evals": 2,
        "projection_min_improvement": 0.01,
        "backbone_ramp_evals": 4,
        "pass_ramp_evals": 2,
        "neuralese_input": "map",
        "input_map_kernel": 4,
        "input_map_rank": 64,
        "rollout_passes": 0
      }
    },
    {
      "id": "autoregressive_text_fixup",
      "kind": "core_text_warmup",
      "requires": [
        "core_text_warmup"
      ],
      "parameters": {
        "steps": 1024,
        "tokens": 1024,
        "prefix_tokens": 32,
        "cutoff": 4,
        "group_size": 16,
        "backbone_training": "auto",
        "optimizer": "muon",
        "eval_every": 128,
        "checkpoint_every": 128,
        "lr": 3e-05,
        "sketch_lr": 0.0003,
        "embedding_weight": 1.0,
        "sketch_weight": 1.0,
        "text_weight": 0.25,
        "max_ce_delta": 0.1,
        "max_relative_mse": 0.25,
        "min_agreement": 0.9,
        "consecutive_gates": 2,
        "batch": 2,
        "projection_patience": 3,
        "projection_min_evals": 2,
        "projection_min_improvement": 0.01,
        "backbone_ramp_evals": 4,
        "pass_ramp_evals": 2,
        "neuralese_input": "map",
        "input_map_kernel": 4,
        "input_map_rank": 64,
        "rollout_passes": 0,
        "ar_feedback_fixup": true
      }
    },
    {
      "id": "adapted_runtime",
      "kind": "text_warmup_runtime",
      "requires": [
        "autoregressive_text_fixup"
      ],
      "parameters": {}
    },
    {
      "id": "recurrence_warmup",
      "kind": "raw_recurrence_training",
      "requires": [
        "autoregressive_text_fixup",
        "adapted_runtime"
      ],
      "parameters": {
        "steps": 2048,
        "batch": 1,
        "lr": 0.0001,
        "backbone_training": "auto",
        "backbone_lr": 3e-05,
        "rank": 16,
        "lora_lr": 2e-05,
        "max_tokens": 65536,
        "train": 2000,
        "eval": 28,
        "handover": "written",
        "write_curriculum": "joint",
        "max_writes": 0,
        "write_depth": 5,
        "tokens_per_vector": 1,
        "max_write_vectors": 512,
        "heads_lr": 3e-05,
        "distill": 0.25,
        "crisp_weight": 1,
        "backward_policy": "auto",
        "graph_headroom_gb": 0.25,
        "checkpoint_layers": true,
        "ffn_chunk_tokens": 1024,
        "optimizer": "muon",
        "checkpoint_every": 25,
        "eval_every": 128,
        "seed": 0,
        "writer_text_weight": 1.0,
        "content_transport": "top-state",
        "writer_length_policy": "native-value",
        "writer_supervision": "native-value",
        "stop_supervision": "gold-native-boundary",
        "sketch_gradient": "local_stage",
        "sketch_target_weight": 0.1,
        "sketch_target_backbone_scale": 0.05,
        "train_control_rows": true,
        "local_stage_batch_size": 16
      }
    }
  ]
}
