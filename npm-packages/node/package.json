{
  "name": "@natlang/node",
  "version": "0.1.0",
  "description": "The Node.js runtime, compiler, CLI internals, terminal utilities, and package APIs for natlang.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepack": "npm --prefix ../../ts-host run build && node ../../scripts/check-staged-package.mjs dist"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^24.0.0",
    "fflate": "^0.8.3",
    "just-bash": "3.4.2",
    "pyodide": "314.0.7",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "default": "./dist/terminal/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./model/pi": {
      "types": "./dist/model/pi-provider.d.ts",
      "default": "./dist/model/pi-provider.js"
    },
    "./package": {
      "types": "./dist/package/index.d.ts",
      "default": "./dist/package/index.js"
    },
    "./adaptation": {
      "types": "./dist/adaptation/node.d.ts",
      "default": "./dist/adaptation/node.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "default": "./dist/evaluation/index.js"
    },
    "./optimize": {
      "types": "./dist/optimization/index.d.ts",
      "default": "./dist/optimization/index.js"
    },
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "default": "./dist/cli/main.js"
    }
  },
  "files": [
    "dist",
    "model-assets",
    "vendor",
    "prelude.js",
    "README.md",
    "examples"
  ]
}
